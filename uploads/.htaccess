Options -Indexes
<FilesMatch "\.(php|phtml|phar|cgi|pl|py|sh)$">
  Require all denied
</FilesMatch>
AddType video/mp4 .mp4
AddType image/webp .webp
<IfModule mod_headers.c>
  <FilesMatch "\.(mp4|webp|jpg|jpeg|png)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

