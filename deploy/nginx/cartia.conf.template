# Instalá este archivo en el Nginx principal del VPS. El contenedor web queda
# ligado a 127.0.0.1:18080 y este proxy conserva el Host original para NestJS.
server {
    listen 80;
    server_name cartia.ar app.cartia.ar *.cartia.ar;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name cartia.ar app.cartia.ar *.cartia.ar;

    # Reemplazar por el certificado wildcard que cubra cartia.ar y *.cartia.ar.
    ssl_certificate     /var/www/cartia-secrets/tls/fullchain.pem;
    ssl_certificate_key /var/www/cartia-secrets/tls/privkey.pem;
    client_max_body_size 55m;

    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }
}
